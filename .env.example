# Rename this file to .env and fill in your keys

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHANNEL_ID=@your_channel_username_or_-100xxxxxxxxxx

# --- Finnhub (stocks, IPO calendar, forex, economic calendar) ---
# Free key: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key

# --- CryptoPanic (crypto news) ---
# Free key: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=your_cryptopanic_key

# --- Cache / polling intervals (in minutes) ---
STOCK_POLL_INTERVAL=5
CRYPTO_POLL_INTERVAL=3
FOREX_POLL_INTERVAL=15
CALENDAR_POLL_INTERVAL=30

# --- Server ---
PORT=4000

# --- Database path ---
# Leave unset for local dev. On Railway, set to /app/data/news_cache.db
# and mount a Volume at /app/data so the cache survives redeploys.
# DB_PATH=/app/data/news_cache.db
